# Copy to .env and edit. Never upload .env to GitHub.
# Demo: open https://play.dhis2.org, click an instance and paste its address here.
# It looks like https://play.im.dhis2.org/<instance-name> (see docs/GUIDE.md).
# For your own DHIS2, use the address you log in at, without /dhis-web-... at the end.
DHIS2_URL=https://play.im.dhis2.org/<instance-name>
DHIS2_USER=admin
DHIS2_PASS=district
DHIS2_DATASET=Child Health
DHIS2_DATA_ELEMENT=ANC 1st visit
DHIS2_FACILITY_LEVEL=4
DHIS2_PERIOD=LAST_12_MONTHS
